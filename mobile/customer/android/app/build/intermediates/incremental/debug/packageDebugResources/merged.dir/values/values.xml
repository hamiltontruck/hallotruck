<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="hallo_gold">#F5B400</color>
    <color name="hallo_line">#DFE7F1</color>
    <color name="hallo_muted">#68778D</color>
    <color name="hallo_navy">#10213D</color>
    <color name="hallo_success">#027A48</color>
    <color name="hallo_surface">#F4F7FB</color>
    <color name="hallo_text">#182033</color>
    <style name="Theme.HalloCustomer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hallo_gold</item><item name="colorOnPrimary">@color/hallo_navy</item>
        <item name="colorSecondary">@color/hallo_navy</item><item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/hallo_surface</item><item name="android:statusBarColor">@color/hallo_navy</item>
    </style>
    <style name="Widget.Hallo.Card" parent="Widget.Material3.CardView.Elevated"><item name="cardBackgroundColor">@android:color/white</item><item name="cardCornerRadius">22dp</item><item name="cardElevation">2dp</item><item name="strokeColor">@color/hallo_line</item><item name="strokeWidth">1dp</item></style>
    <style name="Widget.Hallo.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox"><item name="boxCornerRadiusTopStart">14dp</item><item name="boxCornerRadiusTopEnd">14dp</item><item name="boxCornerRadiusBottomStart">14dp</item><item name="boxCornerRadiusBottomEnd">14dp</item><item name="boxStrokeColor">@color/hallo_line</item><item name="android:layout_marginTop">8dp</item></style>
    <style name="Widget.Hallo.Primary" parent="Widget.Material3.Button"><item name="android:minHeight">52dp</item><item name="cornerRadius">16dp</item><item name="backgroundTint">@color/hallo_gold</item><item name="android:textColor">@color/hallo_navy</item><item name="android:textStyle">bold</item></style>
    <style name="Widget.Hallo.Secondary" parent="Widget.Material3.Button.OutlinedButton"><item name="android:minHeight">48dp</item><item name="cornerRadius">15dp</item><item name="strokeColor">@color/hallo_line</item><item name="android:textColor">@color/hallo_navy</item></style>
</resources>