<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hallo_surface">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nativeAuthScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:contentDescription="HALLO Logistics"
                    android:scaleType="fitStart"
                    android:src="@drawable/hallo_logistics_logo" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/nativeAuthLanguages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nativeAuthEn"
                        style="@style/Widget.Hallo.CompactToggle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="EN" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nativeAuthOr"
                        style="@style/Widget.Hallo.CompactToggle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="OR" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nativeAuthAm"
                        style="@style/Widget.Hallo.CompactToggle"
                        android:layout_width="52dp"
                        android:layout_height="48dp"
                        android:text="አማ" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/hallo_auth_hero" />

            <TextView
                android:id="@+id/nativeAuthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/hallo_navy"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nativeAuthSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/hallo_muted"
                android:textSize="15sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hallo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/nativeSignupFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hallo.AuthInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/full_name">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/nativeFullName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="personName"
                                android:imeOptions="actionNext"
                                android:inputType="textPersonName"
                                android:maxLength="120"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hallo.AuthInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/phone">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/nativePhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="phone"
                                android:imeOptions="actionNext"
                                android:inputType="phone"
                                android:maxLength="17"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nativeEmailLayout"
                        style="@style/Widget.Hallo.AuthInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/email"
                        app:startIconDrawable="@drawable/ic_auth_email"
                        app:startIconTint="@color/hallo_muted">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nativeEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLength="254"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nativePasswordLayout"
                        style="@style/Widget.Hallo.AuthInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/password_pin"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_auth_lock"
                        app:startIconTint="@color/hallo_muted">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nativePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:saveEnabled="false"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nativeConfirmLayout"
                        style="@style/Widget.Hallo.AuthInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/confirm_pin"
                        android:visibility="gone"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_auth_lock"
                        app:startIconTint="@color/hallo_muted">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nativeConfirmPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:imeOptions="actionDone"
                            android:inputType="numberPassword"
                            android:maxLength="6"
                            android:saveEnabled="false"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/nativeAuthFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/hallo_danger"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/nativeAuthProgress"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nativeAuthSubmit"
                        style="@style/Widget.Hallo.AuthPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:icon="@drawable/ic_auth_arrow"
                        app:iconGravity="textEnd" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nativeForgotPassword"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="end|center_vertical"
                        android:text="@string/auth_forgot"
                        android:textAllCaps="false"
                        android:textColor="@color/auth_blue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/nativeAuthPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/hallo_navy"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nativeAuthMode"
                style="@style/Widget.Hallo.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/nativeCustomerShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hallo_surface"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/nativeHeader"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="HALLO Logistics"
                android:scaleType="fitCenter"
                android:src="@drawable/hallo_logistics_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HALLO LOGISTICS"
                    android:textColor="@color/hallo_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/nativeHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/hallo_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/nativeShellProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/nativePageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/nativeBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/white"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nativeNavHome"
                style="@style/Widget.Hallo.NavButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/nav_home"
                app:icon="@drawable/ic_nav_home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nativeNavOrders"
                style="@style/Widget.Hallo.NavButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/nav_orders"
                app:icon="@drawable/ic_nav_orders" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nativeNavBook"
                style="@style/Widget.Hallo.NavButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Book"
                app:icon="@drawable/ic_hallo_truck" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nativeNavTrack"
                style="@style/Widget.Hallo.NavButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/nav_track"
                app:icon="@drawable/ic_nav_track" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nativeNavPayments"
                style="@style/Widget.Hallo.NavButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/nav_payments"
                app:icon="@drawable/ic_nav_payments" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nativeNavProfile"
                style="@style/Widget.Hallo.NavButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/nav_profile"
                app:icon="@drawable/ic_nav_profile" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
