<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flow_review_title" android:textColor="@color/hallo_navy" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/flow_review_subtitle" android:textColor="@color/hallo_muted" android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/flowReviewRoute" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/hallo_navy" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/flowReviewCargo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/hallo_text" android:textSize="14sp" />
                <TextView android:id="@+id/flowReviewTruck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/hallo_text" android:textSize="14sp" />
                <TextView android:id="@+id/flowReviewPayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/hallo_text" android:textSize="14sp" />
                <TextView android:id="@+id/flowReviewTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/auth_blue" android:textSize="27sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/flow_review_server_note" android:textColor="@color/hallo_muted" android:textSize="12sp" />
        <TextView android:id="@+id/flowReviewError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/hallo_danger" android:textSize="12sp" android:visibility="gone" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/flowReviewBack" style="@style/Widget.Hallo.Secondary" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="@string/flow_back_quote" />
            <com.google.android.material.button.MaterialButton android:id="@+id/flowReviewConfirm" style="@style/Widget.Hallo.AuthPrimary" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/flow_confirm_booking" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
