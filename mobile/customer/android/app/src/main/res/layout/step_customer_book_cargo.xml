<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/flow_cargo_title" android:textColor="@color/hallo_navy" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/flow_cargo_subtitle" android:textColor="@color/hallo_muted" android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hallo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/cargo_category">
                    <com.hallo.logistics.customer.HalloDropdownView android:id="@+id/flowCargoCategory" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/quantity">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/flowCargoQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:hint="@string/unit">
                        <com.hallo.logistics.customer.HalloDropdownView android:id="@+id/flowCargoUnit" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/packaging_type">
                    <com.hallo.logistics.customer.HalloDropdownView android:id="@+id/flowCargoPackaging" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/flow_cargo_notes">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/flowCargoNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textCapSentences|textMultiLine" android:maxLength="500" android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:id="@+id/flowCargoSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/hallo_muted" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/flowCargoBack" style="@style/Widget.Hallo.Secondary" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="@string/flow_back_route" />
            <com.google.android.material.button.MaterialButton android:id="@+id/flowCargoNext" style="@style/Widget.Hallo.AuthPrimary" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/flow_next_truck" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
