<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hallo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/nativeProfileAvatar" android:layout_width="86dp" android:layout_height="86dp" android:background="@color/hallo_navy_soft" android:gravity="center" android:textColor="@color/hallo_navy" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/nativeProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/hallo_navy" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:id="@+id/nativeProfileMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:lineSpacingExtra="2dp" android:textColor="@color/hallo_muted" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/nativeProfileEdit" style="@style/Widget.Hallo.Secondary" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:text="@string/edit_profile" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hallo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/native_location_privacy_eyebrow" android:textColor="@color/hallo_gold" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/native_location_privacy_title" android:textColor="@color/hallo_navy" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/native_location_privacy_description" android:textColor="@color/hallo_muted" android:textSize="12sp" />
                <TextView android:id="@+id/nativeProfileLocationStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/hallo_muted" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/nativeProfileShareLocation" style="@style/Widget.Hallo.Primary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="@string/native_share_current_location" android:textSize="11sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/nativeProfileClearLocation" style="@style/Widget.Hallo.Secondary" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/native_clear" android:textSize="11sp" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hallo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/native_account_security_eyebrow" android:textColor="@color/hallo_gold" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/native_account_security_title" android:textColor="@color/hallo_navy" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/native_account_security_description" android:textColor="@color/hallo_muted" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/nativeProfileSignOut" style="@style/Widget.Hallo.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="@string/sign_out" android:textColor="@color/hallo_danger" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
