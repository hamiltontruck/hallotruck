<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/hallo_surface" android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp" android:background="@color/hallo_navy" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_logo_badge" android:contentDescription="HALLO Smart Logistics" android:padding="8dp" android:src="@drawable/ic_hallo_truck"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="HALLO CUSTOMER" android:textColor="@color/hallo_gold" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/headerTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Move smarter" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/navNotifications" style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp" android:layout_height="48dp" android:contentDescription="Notifications" android:text="ALR" android:textColor="@android:color/white" android:visibility="gone"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="30dp" android:layout_height="30dp" android:indeterminateTint="@color/hallo_gold"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="-10dp" android:layout_marginEnd="16dp"><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:padding="14dp" android:textColor="@color/hallo_text" android:textSize="14sp"/></com.google.android.material.card.MaterialCardView>
    <androidx.core.widget.NestedScrollView android:id="@+id/contentScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:paddingBottom="22dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/authPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/authTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Customer sign in" android:textColor="@color/hallo_text" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="14dp" android:text="Book, pay and follow every delivery securely." android:textColor="@color/hallo_muted" android:textSize="14sp"/>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                    <LinearLayout android:id="@+id/signupFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Full name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLength="120"/></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Phone · 09xxxxxxxx"><com.google.android.material.textfield.TextInputEditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:maxLength="17"/></com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email"><com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress"/></com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Password / 6-digit signup PIN" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/></com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmPinLayout" style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Confirm 6-digit PIN" android:visibility="gone" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberPassword" android:maxLength="6"/></com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/authSubmit" style="@style/Widget.Hallo.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Sign in"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/authMode" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create a Customer account" android:textColor="@color/hallo_navy"/>
                </LinearLayout></com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/customerShell" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                <LinearLayout android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/welcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/hallo_text" android:textSize="30sp" android:textStyle="bold"/><TextView android:id="@+id/homeSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/hallo_muted" android:textSize="15sp"/>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE DELIVERY" android:textColor="@color/hallo_success" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/homeActiveOrder" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:textColor="@color/hallo_text" android:textSize="16sp"/><com.google.android.material.button.MaterialButton android:id="@+id/homeTrack" style="@style/Widget.Hallo.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Open live tracking"/></LinearLayout></com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.button.MaterialButton android:id="@+id/startBooking" style="@style/Widget.Hallo.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Create delivery order"/><com.google.android.material.button.MaterialButton android:id="@+id/refresh" style="@style/Widget.Hallo.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Refresh customer data"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/pageBook" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Book a truck" android:textColor="@color/hallo_text" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Search places → HGV distance → secure quote" android:textColor="@color/hallo_muted"/>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Pickup place"><com.google.android.material.textfield.TextInputEditText android:id="@+id/pickupAddress" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Drop-off place"><com.google.android.material.textfield.TextInputEditText android:id="@+id/dropoffAddress" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Choose truck" android:textColor="@color/hallo_muted" android:textStyle="bold"/><Spinner android:id="@+id/vehicleType" android:layout_width="match_parent" android:layout_height="54dp"/>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Cargo weight (tons)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/cargoTons" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal"/></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/calculateQuote" style="@style/Widget.Hallo.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Find route &amp; calculate quote"/><com.hallo.logistics.customer.CustomerLiveMapView android:id="@+id/bookingMap" android:layout_width="match_parent" android:layout_height="250dp" android:layout_marginTop="14dp"/>
                        <TextView android:id="@+id/quoteResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="4dp" android:textColor="@color/hallo_text" android:textStyle="bold"/>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Hallo.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Cargo description"><com.google.android.material.textfield.TextInputEditText android:id="@+id/cargoDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="2"/></com.google.android.material.textfield.TextInputLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Payment method" android:textColor="@color/hallo_muted" android:textStyle="bold"/><Spinner android:id="@+id/paymentMethod" android:layout_width="match_parent" android:layout_height="54dp"/><com.google.android.material.button.MaterialButton android:id="@+id/createOrder" style="@style/Widget.Hallo.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:enabled="false" android:text="Confirm &amp; create order"/>
                    </LinearLayout></com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <LinearLayout android:id="@+id/pageOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My orders" android:textColor="@color/hallo_text" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Status, delivery and cancellation" android:textColor="@color/hallo_muted"/><LinearLayout android:id="@+id/ordersList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/></LinearLayout>
                <LinearLayout android:id="@+id/pageTracking" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live tracking" android:textColor="@color/hallo_text" android:textSize="28sp" android:textStyle="bold"/><TextView android:id="@+id/trackingFreshness" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/hallo_success" android:textStyle="bold"/><com.hallo.logistics.customer.CustomerLiveMapView android:id="@+id/trackingMap" android:layout_width="match_parent" android:layout_height="310dp" android:layout_marginTop="14dp"/><com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp"><ImageView android:id="@+id/driverPhoto" android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="Assigned driver photo" android:scaleType="centerCrop" android:visibility="gone"/><TextView android:id="@+id/driverDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:textColor="@color/hallo_text" android:textSize="16sp"/><TextView android:id="@+id/trackingResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textColor="@color/hallo_muted"/><com.google.android.material.button.MaterialButton android:id="@+id/refreshTracking" style="@style/Widget.Hallo.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Refresh live position"/></LinearLayout></com.google.android.material.card.MaterialCardView></LinearLayout>
                <LinearLayout android:id="@+id/pagePayments" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Payments" android:textColor="@color/hallo_text" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Verified payment and delivery status" android:textColor="@color/hallo_muted"/><LinearLayout android:id="@+id/paymentsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/></LinearLayout>
                <LinearLayout android:id="@+id/pageNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notifications" android:textColor="@color/hallo_text" android:textSize="28sp" android:textStyle="bold"/><LinearLayout android:id="@+id/notificationsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/></LinearLayout>
                <LinearLayout android:id="@+id/pageProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Customer profile" android:textColor="@color/hallo_text" android:textSize="28sp" android:textStyle="bold"/><com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"><TextView android:id="@+id/profileDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="6dp" android:padding="18dp" android:textColor="@color/hallo_text" android:textSize="16sp"/></com.google.android.material.card.MaterialCardView><com.google.android.material.button.MaterialButton android:id="@+id/signOut" style="@style/Widget.Hallo.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Sign out"/></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="64dp" android:background="@android:color/white" android:elevation="12dp" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:visibility="gone" android:weightSum="5">
        <com.google.android.material.button.MaterialButton android:id="@+id/navHome" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:text="Home" android:textColor="@color/hallo_navy" android:textSize="11sp"/><com.google.android.material.button.MaterialButton android:id="@+id/navBook" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:text="Book" android:textColor="@color/hallo_navy" android:textSize="11sp"/><com.google.android.material.button.MaterialButton android:id="@+id/navOrders" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:text="Orders" android:textColor="@color/hallo_navy" android:textSize="11sp"/><com.google.android.material.button.MaterialButton android:id="@+id/navTrack" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:text="Track" android:textColor="@color/hallo_navy" android:textSize="11sp"/><com.google.android.material.button.MaterialButton android:id="@+id/navProfile" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:minWidth="0dp" android:padding="2dp" android:text="Profile" android:textColor="@color/hallo_navy" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
