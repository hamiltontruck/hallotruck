<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CARGO TRACKING" android:textColor="@color/hallo_gold" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/nativeTrackingId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/hallo_navy" android:textSize="25sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/nativeTrackingGpsBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_step_idle" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp" android:textColor="@color/hallo_navy" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nativeTrackingTimeline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <TextView android:id="@+id/nativeStepAssigned" android:layout_width="0dp" android:layout_height="60dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_step_idle" android:gravity="center" android:text="1\nAssigned" android:textColor="@color/hallo_navy" android:textSize="10sp" />
            <TextView android:id="@+id/nativeStepPickup" android:layout_width="0dp" android:layout_height="60dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_step_idle" android:gravity="center" android:text="2\nPickup" android:textColor="@color/hallo_navy" android:textSize="10sp" />
            <TextView android:id="@+id/nativeStepRoute" android:layout_width="0dp" android:layout_height="60dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_step_idle" android:gravity="center" android:text="3\nOn route" android:textColor="@color/hallo_navy" android:textSize="10sp" />
            <TextView android:id="@+id/nativeStepDelivered" android:layout_width="0dp" android:layout_height="60dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/bg_step_idle" android:gravity="center" android:text="4\nDelivered" android:textColor="@color/hallo_navy" android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nativeTrackingAssignmentCard"
            style="@style/Widget.Hallo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assigned_driver_truck" android:textColor="@color/hallo_gold" android:textSize="10sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/nativeTrackingDriverPhoto" android:layout_width="62dp" android:layout_height="62dp" android:background="@color/hallo_navy_soft" android:contentDescription="Assigned driver" android:scaleType="centerCrop" android:src="@drawable/hallo_logistics_logo" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/nativeTrackingDriverName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/hallo_navy" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/nativeTrackingDriverMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/hallo_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/nativeTrackingTruckPhoto" android:layout_width="76dp" android:layout_height="62dp" android:background="@color/hallo_navy_soft" android:contentDescription="Assigned truck" android:scaleType="centerCrop" android:src="@drawable/truck_10_ton" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/nativeTrackingCall" style="@style/Widget.Hallo.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/call" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/nativeTrackingChat" style="@style/Widget.Hallo.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Chat" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="22dp">
            <com.hallo.logistics.customer.CustomerLiveMapView android:id="@+id/nativeTrackingMap" android:layout_width="match_parent" android:layout_height="360dp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="0dp" android:layout_height="92dp" android:layout_marginEnd="4dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPS" android:textColor="@color/hallo_muted" android:textSize="10sp"/><TextView android:id="@+id/nativeTrackingGps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="@color/hallo_navy" android:textSize="13sp" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="0dp" android:layout_height="92dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Remaining" android:textColor="@color/hallo_muted" android:textSize="10sp"/><TextView android:id="@+id/nativeTrackingRemaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="@color/hallo_navy" android:textSize="13sp" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Hallo.Card" android:layout_width="0dp" android:layout_height="92dp" android:layout_marginStart="4dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ETA" android:textColor="@color/hallo_muted" android:textSize="10sp"/><TextView android:id="@+id/nativeTrackingEta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="@color/hallo_navy" android:textSize="13sp" android:textStyle="bold"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView android:id="@+id/nativeTrackingRoute" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@color/hallo_navy_soft" android:lineSpacingExtra="3dp" android:padding="14dp" android:textColor="@color/hallo_text" android:textSize="14sp" />

        <TextView android:id="@+id/nativeTrackingWaiting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:padding="20dp" android:text="@string/waiting_gps" android:textColor="@color/hallo_muted" android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/nativeTrackingRefresh" style="@style/Widget.Hallo.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="@string/refresh_live_position" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
