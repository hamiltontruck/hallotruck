<resources>
    <color name="auth_blue">@color/hallo_blue</color>
    <color name="auth_background">@color/hallo_surface</color>

    <style name="Widget.Hallo.AuthPrimary" parent="Widget.Hallo.Primary">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/auth_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Hallo.AuthInput" parent="Widget.Hallo.Input">
        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeColor">@color/auth_blue</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>
</resources>
