<resources>
    <color name="auth_blue">#0B63F6</color>
    <color name="auth_background">#F6F9FD</color>

    <style name="Widget.Hallo.AuthPrimary" parent="Widget.Hallo.Primary">
        <item name="backgroundTint">@color/hallo_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Hallo.AuthInput" parent="Widget.Hallo.Input">
        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeColor">@color/hallo_line</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/hallo_muted</item>
    </style>
</resources>
