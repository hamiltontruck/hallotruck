<resources>
    <style name="Theme.HalloCustomer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hallo_navy</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/hallo_gold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:statusBarColor">@color/hallo_navy</item>
        <item name="android:windowBackground">@drawable/hallo_splash_background</item>
    </style>

    <style name="Widget.Hallo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/hallo_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Hallo.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/hallo_navy</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Hallo.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/hallo_line</item>
        <item name="android:textColor">@color/hallo_navy</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Hallo.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/hallo_line</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Widget.Hallo.CompactToggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:textSize">10sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/hallo_line</item>
        <item name="android:textColor">@color/hallo_navy</item>
    </style>

    <style name="Widget.Hallo.NavButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconSize">21dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">2dp</item>
        <item name="android:paddingLeft">1dp</item>
        <item name="android:paddingRight">1dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
</resources>
