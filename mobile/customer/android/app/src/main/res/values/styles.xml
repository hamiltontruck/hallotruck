<resources>
    <style name="Theme.HalloCustomer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hallo_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/hallo_navy</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:statusBarColor">@color/hallo_surface</item>
        <item name="android:windowBackground">@color/hallo_surface</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Widget.Hallo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/hallo_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Hallo.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/hallo_blue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Hallo.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">50dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/hallo_line</item>
        <item name="android:textColor">@color/hallo_navy</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Hallo.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeColor">@color/hallo_line</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Widget.Hallo.CompactToggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingLeft">7dp</item>
        <item name="android:paddingRight">7dp</item>
        <item name="android:textSize">10sp</item>
        <item name="cornerRadius">13dp</item>
        <item name="strokeColor">@color/hallo_line</item>
        <item name="backgroundTint">@color/hallo_language_toggle_background</item>
        <item name="android:textColor">@color/hallo_language_toggle_text</item>
    </style>

    <style name="Widget.Hallo.NavButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">2dp</item>
        <item name="android:paddingLeft">1dp</item>
        <item name="android:paddingRight">1dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
</resources>
