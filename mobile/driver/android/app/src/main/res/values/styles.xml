<resources>
    <style name="Theme.HalloDriver" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#F5B400</item>
    </style>

    <style name="Widget.Hallo.DriverNavButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="backgroundTint">@color/driver_nav_background</item>
        <item name="android:textColor">@color/driver_nav_text</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>
</resources>
