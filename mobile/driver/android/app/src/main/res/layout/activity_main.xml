<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hallo_surface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/hallo_navy"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="7dp"
            android:src="@drawable/ic_hallo_truck"
            android:contentDescription="@string/app_name"
            app:tint="@color/hallo_gold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_driver"
                android:textColor="@color/hallo_gold"
                android:textStyle="bold"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ready_to_move"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/languageAction"
            style="@style/Widget.HalloDriver.HeaderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="OR"
            android:contentDescription="@string/language" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/documentsAction"
            style="@style/Widget.HalloDriver.HeaderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/documents_short"
            android:textSize="9sp"
            android:contentDescription="@string/documents"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationsAction"
            style="@style/Widget.HalloDriver.HeaderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="@string/notifications_short"
            android:textSize="16sp"
            android:contentDescription="@string/notifications"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="@color/hallo_gold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        style="@style/Widget.HalloDriver.StatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp">
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="@color/hallo_text"
            android:textSize="13sp"
            android:accessibilityLiveRegion="polite" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/authPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView style="@style/TextAppearance.HalloDriver.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_back" />
                <TextView style="@style/TextAppearance.HalloDriver.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/signin_help" android:layout_marginBottom="14dp" />
                <LinearLayout android:id="@+id/signupFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/full_name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" /></com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ethiopian_mobile"><com.google.android.material.textfield.TextInputEditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" /></com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/email"><com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/password_pin" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/pin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberPassword" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmPinLayout" style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/confirm_pin" app:endIconMode="password_toggle" android:visibility="gone"><com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberPassword" android:maxLength="6" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/authSubmit" style="@style/Widget.HalloDriver.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sign_in" />
                <com.google.android.material.button.MaterialButton android:id="@+id/authMode" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/create_driver_account" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/driverShell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/accessState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_status_chip"
                    android:textColor="@color/hallo_success"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp">
                    <TextView style="@style/TextAppearance.HalloDriver.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/driver_home" />
                    <TextView style="@style/TextAppearance.HalloDriver.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workday_glance" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:weightSum="3">
                        <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.MetricCard" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginEnd="4dp">
                            <TextView android:id="@+id/homeAvailableJobs" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="8dp" android:textColor="@color/hallo_navy" android:textSize="18sp" android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.MetricCard" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                            <TextView android:id="@+id/homeActiveTrip" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="8dp" android:textColor="@color/hallo_navy" android:textSize="13sp" android:textStyle="bold" android:maxLines="3" android:ellipsize="end" />
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.MetricCard" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginStart="4dp">
                            <TextView android:id="@+id/homeDocuments" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="8dp" android:textColor="@color/hallo_navy" android:textSize="13sp" android:textStyle="bold" android:maxLines="3" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView android:id="@+id/homeSummary" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.DarkCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <TextView android:id="@+id/homeAssignment" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:padding="16dp" android:textColor="@android:color/white" android:textSize="14sp" android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.ContentCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                        <TextView android:id="@+id/homeEarnings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp" android:padding="16dp" android:textColor="@color/hallo_text" android:textSize="14sp" android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton android:id="@+id/refresh" style="@style/Widget.HalloDriver.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/refresh_driver_data" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageOnboarding" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="10dp">
                    <TextView style="@style/TextAppearance.HalloDriver.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/documents" />
                    <TextView style="@style/TextAppearance.HalloDriver.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/document_workspace" android:layout_marginBottom="14dp" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/plate_number"><com.google.android.material.textfield.TextInputEditText android:id="@+id/plate" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
                    <Spinner android:id="@+id/vehicleType" style="@style/Widget.HalloDriver.Spinner" android:layout_width="match_parent" android:layout_height="48dp" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/capacity_tons"><com.google.android.material.textfield.TextInputEditText android:id="@+id/capacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" /></com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/saveVehicle" style="@style/Widget.HalloDriver.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save_vehicle" />
                    <Spinner android:id="@+id/documentKey" style="@style/Widget.HalloDriver.Spinner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/chooseDocument" style="@style/Widget.HalloDriver.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/choose_document" />
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.ContentCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <TextView android:id="@+id/documentState" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:textColor="@color/hallo_text" android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout android:id="@+id/pageJobs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="10dp">
                    <TextView style="@style/TextAppearance.HalloDriver.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/available_jobs" />
                    <TextView style="@style/TextAppearance.HalloDriver.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/available_jobs_help" android:layout_marginBottom="10dp" />
                    <LinearLayout android:id="@+id/jobsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageTrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="10dp">
                    <TextView style="@style/TextAppearance.HalloDriver.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/active_trip" />
                    <TextView style="@style/TextAppearance.HalloDriver.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trip_workspace" />

                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.ContentCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                        <TextView android:id="@+id/tripDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:padding="16dp" android:textColor="@color/hallo_text" android:textSize="14sp" android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.hallo.logistics.driver.LiveTripMapView android:id="@+id/liveTripMap" android:layout_width="match_parent" android:layout_height="360dp" android:layout_marginTop="12dp" />
                    <TextView android:id="@+id/liveMapState" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="8dp" android:paddingBottom="10dp" android:textColor="@color/hallo_text_muted" android:textSize="12sp" />

                    <LinearLayout android:id="@+id/tripActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/startTrip" style="@style/Widget.HalloDriver.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_trip" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/startTracking" style="@style/Widget.HalloDriver.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/start_gps" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/stopTracking" style="@style/Widget.HalloDriver.DangerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/stop_gps" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/openNavigation" style="@style/Widget.HalloDriver.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/open_navigation" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.ContentCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                        <LinearLayout android:id="@+id/deliveryPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
                            <TextView style="@style/TextAppearance.HalloDriver.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/delivery_completion" />
                            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/receiver_name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/recipient" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/delivery_note"><com.google.android.material.textfield.TextInputEditText android:id="@+id/deliveryNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" /></com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/pickPhoto" style="@style/Widget.HalloDriver.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pick_delivery_photo" />
                            <TextView android:id="@+id/photoState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/photo_required" android:textColor="@color/hallo_text_muted" android:textSize="12sp" android:padding="8dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/pickSignature" style="@style/Widget.HalloDriver.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pick_signature" />
                            <TextView android:id="@+id/signatureState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/signature_required" android:textColor="@color/hallo_text_muted" android:textSize="12sp" android:padding="8dp" />
                            <Spinner android:id="@+id/paymentResult" style="@style/Widget.HalloDriver.Spinner" android:layout_width="match_parent" android:layout_height="48dp" />
                            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.HalloDriver.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/amount_collected"><com.google.android.material.textfield.TextInputEditText android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" /></com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.button.MaterialButton android:id="@+id/finishTrip" style="@style/Widget.HalloDriver.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/complete_delivery" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout android:id="@+id/pageWallet" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="10dp">
                    <TextView style="@style/TextAppearance.HalloDriver.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/earnings" />
                    <TextView style="@style/TextAppearance.HalloDriver.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/finance_workspace" />

                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.DarkCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                        <TextView android:id="@+id/walletDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="150dp" android:padding="16dp" android:textColor="@android:color/white" android:textSize="14sp" android:lineSpacingExtra="5dp" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.HighlightCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                        <TextView android:id="@+id/commissionDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="82dp" android:padding="16dp" android:textColor="@color/hallo_navy" android:textSize="14sp" android:textStyle="bold" android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView style="@style/TextAppearance.HalloDriver.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/trip_history" />
                    <LinearLayout android:id="@+id/tripHistoryList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView style="@style/TextAppearance.HalloDriver.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/deposit_history" />
                    <LinearLayout android:id="@+id/depositHistoryList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView style="@style/TextAppearance.HalloDriver.SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/commission_payment_history" />
                    <LinearLayout android:id="@+id/commissionPaymentsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageAlerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="10dp">
                    <TextView style="@style/TextAppearance.HalloDriver.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notifications" />
                    <TextView style="@style/TextAppearance.HalloDriver.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notification_workspace" android:layout_marginBottom="10dp" />
                    <LinearLayout android:id="@+id/alertsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="10dp">
                    <TextView style="@style/TextAppearance.HalloDriver.PageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile" />
                    <TextView style="@style/TextAppearance.HalloDriver.PageSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_workspace" />

                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.ContentCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
                        <TextView android:id="@+id/profileDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="130dp" android:padding="16dp" android:textColor="@color/hallo_text" android:textSize="14sp" android:lineSpacingExtra="5dp" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.HalloDriver.ContentCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                        <TextView android:id="@+id/profileVehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:padding="16dp" android:textColor="@color/hallo_text" android:textSize="14sp" android:lineSpacingExtra="4dp" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.button.MaterialButton android:id="@+id/profileDocuments" style="@style/Widget.HalloDriver.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/documents" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/signOut" style="@style/Widget.HalloDriver.DangerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/logout" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:visibility="gone"
        android:background="@color/hallo_card"
        app:itemIconTint="@color/selector_bottom_nav"
        app:itemTextColor="@color/selector_bottom_nav"
        app:itemActiveIndicatorStyle="@style/Widget.HalloDriver.BottomNavIndicator"
        app:labelVisibilityMode="labeled"
        app:itemHorizontalTranslationEnabled="false"
        app:menu="@menu/driver_bottom_navigation" />
</LinearLayout>
