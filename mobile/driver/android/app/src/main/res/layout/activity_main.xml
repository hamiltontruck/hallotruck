<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/hallo_surface" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/hallo_navy"
        android:paddingStart="12dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="7dp" android:src="@drawable/ic_hallo_truck"
            android:contentDescription="@string/app_name" app:tint="@color/hallo_gold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/brand_driver" android:textColor="@color/hallo_gold" android:textStyle="bold" android:textSize="11sp" />
            <TextView android:id="@+id/headerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ready_to_move" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/languageAction" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:text="OR" android:textSize="11sp" android:contentDescription="@string/language" />
        <com.google.android.material.button.MaterialButton android:id="@+id/documentsAction" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:text="@string/documents_short" android:textSize="9sp" android:contentDescription="@string/documents" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/notificationsAction" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:text="@string/notifications_short" android:textSize="16sp" android:contentDescription="@string/notifications" android:visibility="gone" />
        <ProgressBar android:id="@+id/progress" android:layout_width="28dp" android:layout_height="28dp" android:indeterminateTint="@color/hallo_gold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/statusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/hallo_text" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView android:id="@+id/contentScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <LinearLayout android:id="@+id/authPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_back" android:textColor="@color/hallo_text" android:textStyle="bold" android:textSize="26sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/signin_help" android:textColor="@color/hallo_text_muted" android:textSize="14sp" android:layout_marginBottom="12dp" />
                <LinearLayout android:id="@+id/signupFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/full_name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" /></com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ethiopian_mobile"><com.google.android.material.textfield.TextInputEditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" /></com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/email"><com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/password_pin" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/pin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberPassword" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmPinLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/confirm_pin" app:endIconMode="password_toggle" android:visibility="gone"><com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmPin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberPassword" android:maxLength="6" /></com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/authSubmit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/sign_in" />
                <com.google.android.material.button.MaterialButton android:id="@+id/authMode" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/create_driver_account" />
            </LinearLayout>

            <LinearLayout android:id="@+id/driverShell" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
                <TextView android:id="@+id/accessState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:textColor="@color/hallo_success" android:textStyle="bold" />

                <LinearLayout android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/driver_home" android:textStyle="bold" android:textSize="24sp" android:textColor="@color/hallo_text" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/workday_glance" android:textColor="@color/hallo_text_muted" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:weightSum="3">
                        <TextView android:id="@+id/homeAvailableJobs" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:gravity="center" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/homeActiveTrip" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
                        <TextView android:id="@+id/homeDocuments" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:gravity="center" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView android:id="@+id/homeSummary" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/homeAssignment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="16dp" android:background="@color/hallo_navy" android:textColor="@android:color/white" android:lineSpacingExtra="4dp" />
                    <TextView android:id="@+id/homeEarnings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="16dp" android:textColor="@color/hallo_text" android:lineSpacingExtra="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/refresh_driver_data" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageOnboarding" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/documents" android:textStyle="bold" android:textSize="24sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/document_workspace" android:textColor="@color/hallo_text_muted" />
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/plate_number"><com.google.android.material.textfield.TextInputEditText android:id="@+id/plate" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
                    <Spinner android:id="@+id/vehicleType" android:layout_width="match_parent" android:layout_height="48dp" />
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/capacity_tons"><com.google.android.material.textfield.TextInputEditText android:id="@+id/capacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" /></com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/saveVehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/save_vehicle" />
                    <Spinner android:id="@+id/documentKey" android:layout_width="match_parent" android:layout_height="48dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/chooseDocument" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/choose_document" />
                    <TextView android:id="@+id/documentState" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageJobs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/available_jobs" android:textStyle="bold" android:textSize="24sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/available_jobs_help" android:textColor="@color/hallo_text_muted" />
                    <LinearLayout android:id="@+id/jobsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageTrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/active_trip" android:textStyle="bold" android:textSize="24sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trip_workspace" android:textColor="@color/hallo_text_muted" />
                    <TextView android:id="@+id/tripDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:lineSpacingExtra="4dp" />
                    <com.hallo.logistics.driver.LiveTripMapView android:id="@+id/liveTripMap" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="10dp" />
                    <TextView android:id="@+id/liveMapState" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" />
                    <LinearLayout android:id="@+id/tripActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/startTrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/start_trip" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/startTracking" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/start_gps" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/stopTracking" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/stop_gps" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/openNavigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/open_navigation" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/deliveryPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/delivery_completion" android:textStyle="bold" android:textSize="20sp" android:paddingTop="14dp" />
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/receiver_name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/recipient" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/delivery_note"><com.google.android.material.textfield.TextInputEditText android:id="@+id/deliveryNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:minLines="2" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/pickPhoto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/pick_delivery_photo" />
                        <TextView android:id="@+id/photoState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/photo_required" android:padding="8dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/pickSignature" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/pick_signature" />
                        <TextView android:id="@+id/signatureState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/signature_required" android:padding="8dp" />
                        <Spinner android:id="@+id/paymentResult" android:layout_width="match_parent" android:layout_height="48dp" />
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/amount_collected"><com.google.android.material.textfield.TextInputEditText android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" /></com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/finishTrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/complete_delivery" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/pageWallet" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/earnings" android:textStyle="bold" android:textSize="24sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/finance_workspace" android:textColor="@color/hallo_text_muted" />
                    <TextView android:id="@+id/walletDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:lineSpacingExtra="4dp" />
                    <TextView android:id="@+id/commissionDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trip_history" android:textStyle="bold" android:textSize="18sp" />
                    <LinearLayout android:id="@+id/tripHistoryList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/deposit_history" android:textStyle="bold" android:textSize="18sp" android:paddingTop="12dp" />
                    <LinearLayout android:id="@+id/depositHistoryList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/commission_payment_history" android:textStyle="bold" android:textSize="18sp" android:paddingTop="12dp" />
                    <LinearLayout android:id="@+id/commissionPaymentsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageAlerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notifications" android:textStyle="bold" android:textSize="24sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notification_workspace" android:textColor="@color/hallo_text_muted" />
                    <LinearLayout android:id="@+id/alertsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout android:id="@+id/pageProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile" android:textStyle="bold" android:textSize="24sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_workspace" android:textColor="@color/hallo_text_muted" />
                    <TextView android:id="@+id/profileDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:lineSpacingExtra="4dp" />
                    <TextView android:id="@+id/profileVehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/profileDocuments" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/documents" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/signOut" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/logout" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigation"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:visibility="gone"
        app:labelVisibilityMode="labeled" app:itemHorizontalTranslationEnabled="false" app:menu="@menu/driver_bottom_navigation" />
</LinearLayout>