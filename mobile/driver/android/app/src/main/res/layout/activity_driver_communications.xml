<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F6F8FC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="72dp" android:layout_height="44dp" android:contentDescription="@string/comms_logo_description" android:scaleType="fitCenter" android:src="@drawable/hallo_logistics_logo"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comms_title" android:textColor="#0B1F3A" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comms_subtitle" android:textColor="#5B6678" android:textSize="13sp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/closeAction" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/comms_close"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#DCE3EE" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comms_order_context" android:textColor="#0B1F3A" android:textStyle="bold" android:textSize="16sp"/>
                <Spinner android:id="@+id/orderSelector" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/orderSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#344054" android:textSize="14sp"/>
                <TextView android:id="@+id/customerContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#344054" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/chatModeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/customerMode" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="@string/comms_customer"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/operationsMode" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="@string/comms_operations"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#DCE3EE" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:id="@+id/chatStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#667085" android:textSize="13sp"/>
                <ScrollView android:id="@+id/messagesScroll" android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="8dp" android:fillViewport="true">
                    <LinearLayout android:id="@+id/messagesList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp"/>
                </ScrollView>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" android:hint="@string/comms_message_hint">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/messageInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="4000" android:maxLines="4" android:minHeight="52dp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/sendMessage" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/comms_send" app:cornerRadius="14dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#F1C9C9" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comms_dispute_title" android:textColor="#7A1F1F" android:textStyle="bold" android:textSize="16sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/comms_dispute_hint" android:textColor="#667085" android:textSize="13sp"/>
                <Spinner android:id="@+id/disputeCategory" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp"/>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" android:hint="@string/comms_dispute_details_hint">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/disputeDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="2000" android:minLines="3" android:maxLines="7"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/submitDispute" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/comms_submit_dispute" app:cornerRadius="14dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/comms_dispute_history" android:textColor="#0B1F3A" android:textStyle="bold" android:textSize="15sp"/>
                <LinearLayout android:id="@+id/disputesList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/screenStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="#667085" android:textSize="13sp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
