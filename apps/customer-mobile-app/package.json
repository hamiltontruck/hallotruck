{
  "name": "@hallotruck/customer-mobile-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-capacitor-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.policy.json && node --test tests/*.test.mjs",
    "test:ci": "npm run typecheck && npm test && npm run build",
    "android:add": "cap add android && node scripts/apply-android-icons.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/apply-android-icons.mjs",
    "android:icons": "node scripts/apply-android-icons.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "7.4.3",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/cli": "7.4.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.2"
  }
}
