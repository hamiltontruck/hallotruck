
import { readFile, writeFile, mkdir } from "node:fs/promises";
import path from "node:path";

const root = process.cwd();

async function read(relativePath) {
  return readFile(path.join(root, relativePath), "utf8");
}

async function write(relativePath, content) {
  const target = path.join(root, relativePath);
  await mkdir(path.dirname(target), { recursive: true });
  await writeFile(target, content, "utf8");
}

function replaceOnce(content, before, after, file) {
  if (!content.includes(before)) {
    throw new Error(`Expected text not found in ${file}: ${before.slice(0, 120)}`);
  }
  return content.replace(before, after);
}

function replaceRegex(content, pattern, after, file) {
  if (!pattern.test(content)) {
    throw new Error(`Expected pattern not found in ${file}: ${pattern}`);
  }
  pattern.lastIndex = 0;
  return content.replace(pattern, after);
}

